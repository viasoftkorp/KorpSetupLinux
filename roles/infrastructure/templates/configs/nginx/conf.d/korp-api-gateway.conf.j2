{% if reverse_proxy.external %}
server {
    listen {{ reverse_proxy.http_ports.dns_api_gateway | default('9878') }};

    include /etc/nginx/default_conf;
{% if certs.certbot_automated.certificate %}

    # Desafio do Let's Encrypt também neste servidor: atrás de um proxy que repassa em HTTPS (ex.: Azure Front Door)
    # ou nas portas HTTP do proxy reverso externo, a renovação não chega na porta 80 (acme-challenge.conf)
    location ^~ /.well-known/acme-challenge/ {
        root /letsencrypt/;
    }
{% endif %}

    include /etc/nginx/conf.d/korp-api-gateway.locations;
}
{% endif %}

server {
    server_name {{ dns.api_gateway }};

    include /etc/nginx/ssl_conf;
    include /etc/nginx/default_conf;
{% if certs.certbot_automated.certificate %}

    # Desafio do Let's Encrypt também neste servidor: atrás de um proxy que repassa em HTTPS (ex.: Azure Front Door)
    # ou nas portas HTTP do proxy reverso externo, a renovação não chega na porta 80 (acme-challenge.conf)
    location ^~ /.well-known/acme-challenge/ {
        root /letsencrypt/;
    }
{% endif %}

    include /etc/nginx/conf.d/korp-api-gateway.ssl-locations;
}
