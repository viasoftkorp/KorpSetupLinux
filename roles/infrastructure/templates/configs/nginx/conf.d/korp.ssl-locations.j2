location ~ /reporting/stimulsoft/* {
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;
    proxy_set_header X-Forwarded-Proto https;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Host $host;

    proxy_pass http://fabio:9999;
}

# Apuração de CBS (FIS70): a tela que a casca abre num iframe na mesma origem do portal. O nome é resolvido na
# requisição (DNS do Docker), então o nginx sobe sem o FIS70 instalado; nesse caso este caminho responde 502.
location ^~ /fiscal/apuracao-cbs/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $korp_apuracaocbs_parcel http://korp-fiscal-apuracaocbs-parcel:80;

    proxy_set_header X-Forwarded-Proto https;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Host $host;

    proxy_pass $korp_apuracaocbs_parcel;
}

location / {
    proxy_set_header X-Forwarded-Proto https;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Host $host;   

    # Necessário para conexões persistentes (keepalive)
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    proxy_pass http://Viasoft.Loader_upstream;
}