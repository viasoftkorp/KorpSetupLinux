{
  "Authorization": {
    "Secret": "{{ secret }}"
  },
  "Provisioning": {
    "EnableSchemaProvisioning": "false"
  },
  "ServiceBus": {
    "StorageConnectionString": "Server=db_mssql; Database={{ service_vars.db.name }}; User Id={{ mssql.korp_user }}; Password={{ mssql.korp_password }}; MultipleActiveResultSets=true; Encrypt=False"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=db_mssql; Database={{ service_vars.db.name }}; User Id={{ mssql.korp_user }}; Password={{ mssql.korp_password }}; Encrypt=False"
  },
  "EnableEnvironmentDependentConnectionString": "true",
  "Importacao": {
      "Memory": {
        "LimitMiB": 1024,
        "AdmissionLimitPercent": 80
      },
      "Upload": {
        "MaxConcurrentPerUser": 3,
        "MaxConcurrentPerInstance": 8,
        "MaxFileSizeMiB": 10
      },
      "Reconciliation": {
      	"AbandonedImportRetentionMinutes": 10, 
        "CleanupBatchSize": 100
      }
  }
}