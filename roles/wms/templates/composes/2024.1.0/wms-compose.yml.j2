version: "3.8"

x-extra_hosts:
  &default-extra_hosts
  - "db_mssql:$DB_MSSQL"
  - "testing_db_mssql:$TESTING_DB_MSSQL" 
  - "app_server:$APP_SERVER"
  - "{{ dns.api }}:$API_GATEWAY"
  - "{{ dns.frontend }}:$PORTAL_GATEWAY"
  - "{{ dns.cdn }}:$CDN_GATEWAY"
{% if dns.api_gateway is defined and dns.api_gateway != "" %}
  - "{{ dns.api_gateway }}:$API_GATEWAY_GATEWAY"
{% endif %}

networks:
  servicos:
    external:
      name: servicos

services:
  korp-logistica-picking-2024-1-0:
    image: "{{ docker_account }}/korp.logistica.picking:2024.1.0.x{{ docker_image_suffix }}"
    container_name: "Korp.Logistica.Picking-2024.1.0"
    restart: unless-stopped
    extra_hosts: *default-extra_hosts
    environment:
      - ON_PREMISE_MODE=true
      - USE_SERVERGC=$USE_SERVERGC
      - URL_CONSUL=http://consul-server:8500
      - CERT_FILE_PATH={{ containers_cert_path }}
    networks:
      - servicos
    dns_opt:
      - single-request-reopen
    volumes:
      - "{{ certs_directory }}/:{{ certs_directory }}/"

  korp-logistic-picking-analisedeestoque-2024.1.0:
